# Copy to .env (git-ignored) and fill in what you need. Values already set in your
# shell take precedence over this file.

# ---- Paths ---------------------------------------------------------------
# Repository root; defaults to this checkout.
# EKKA_ROOT=/path/to/Ekka
# Where activation tensors are written by the drivers and read by the agent.
# Defaults to $EKKA_ROOT/activations. Activations can be tens of GB per case.
# EKKA_ACTIVATION_DIR=/data/ekka/activations

# ---- LLM backend ---------------------------------------------------------
# Overrides `provider` / `model_id` in every diagnosis config.
# EKKA_LLM_PROVIDER=anthropic        # bedrock | anthropic
# EKKA_MODEL_ID=claude-sonnet-4-5-20250929

# provider: anthropic
# ANTHROPIC_API_KEY=

# provider: bedrock (any standard AWS credential source works, e.g. AWS_PROFILE)
# AWS_REGION=us-east-1
# AWS_PROFILE=
# Read timeout for Bedrock calls in seconds (default 1800).
# EKKA_BEDROCK_READ_TIMEOUT=1800

# ---- Hugging Face --------------------------------------------------------
# Needed for gated models (Llama, Gemma, ...).
# HF_TOKEN=

# ---- Optional: LangSmith tracing -----------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ekka
