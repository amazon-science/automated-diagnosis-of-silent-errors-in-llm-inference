    "reasoning": {
        "HF": {
            "root": "Root level Gemma3ForConditionalGeneration. This is the top-level model container. It contains a 'model' attribute of type Gemma3Model. Maps to vLLM root directly but with different internal structure.",
            "root.lm_head": "In HF, lm_head is an explicit nn.Linear module that projects hidden states to vocabulary logits. The weights are tied to the embedding layer via _tied_weights_keys. In vLLM, there is no explicit lm_head module at this level. Instead, logits are computed via root.language_model.logits_processor which reuses embed_tokens weights. This is a weight-tying implementation difference and NOT a mapping issue.",
            "root.model.language_model.rotary_emb": "Gemma3RotaryEmbedding for global attention in HF. In vLLM, rotary embeddings are computed per-layer within each Gemma3Attention module via root.language_model.model.layers.{j}.self_attn.rotary_emb. This is an architectural difference where HF has shared global/local rotary embeddings at the model level, while vLLM implements them within each attention layer based on whether it uses sliding window attention.",
            "root.model.language_model.rotary_emb_local": "Gemma3RotaryEmbedding for local/sliding window attention in HF. Similar to rotary_emb, this is implemented per-layer in vLLM within each attention module based on the layer's attention type (sliding vs global)."
        },
        "vLLM": {
            "root": "Root level Gemma3ForConditionalGeneration. Contains vision_tower and language_model directly without intermediate wrapper. Maps to root.model in HF for subcomponents.",
            "root.language_model": "Gemma3ForCausalLM in vLLM. This wraps a 'model' attribute of type Gemma3Model. The model attribute corresponds to root.model.language_model in HF (Gemma3TextModel).",
            "root.language_model.logits_processor": "vLLM-specific component for logits processing including soft-capping. In HF, logits are computed via root.lm_head Linear layer. This represents vLLM's optimized serving approach where the lm_head computation is handled by a specialized processor that reuses embedding weights.",
            "root.vision_tower.vision_model.encoder.layers.{i}.self_attn.attn": "MultiHeadAttention module in vLLM that implements the actual attention computation. In HF, the attention computation is done inline within SiglipAttention.forward() using attention_interface functions. This is an implementation detail difference - vLLM extracts attention into a separate module for optimization.",
            "root.language_model.model.layers.{j}.self_attn.rotary_emb": "RotaryEmbeddingWrapper in vLLM that wraps the actual rotary embedding computation. Each layer has its own rotary embedding based on whether it uses sliding window (local) or global attention. In HF, there are two shared rotary embeddings (rotary_emb and rotary_emb_local) at the model level that are selected in forward pass.",
            "root.language_model.model.layers.{j}.self_attn.attn": "Attention module in vLLM that implements the actual attention computation with KV caching and optimization. In HF, attention computation is done inline within Gemma3Attention.forward() using attention_interface. This is an implementation difference where vLLM uses a separate module for serving optimizations."
        }
    }
