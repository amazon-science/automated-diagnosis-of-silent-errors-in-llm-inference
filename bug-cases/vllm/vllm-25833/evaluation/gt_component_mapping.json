    "reasoning": {
        "HF": {
            "root.model.rotary_emb": "Mapped to root.model.layers.{k}.self_attn.rotary_emb for k in [0-27]. Rotary embedding module in HF is standalone at model level and shared across all layers. In vLLM, rotary embedding functionality is instantiated per-layer as a RotaryEmbeddingWrapper within each attention layer for optimized computation. Functionality is equivalent, implemented at different granularity levels.",
            "root.model.layers.{i}.mlp.experts": "ModuleList container holding 64 expert modules for MoE layers i in [1-27]. Container itself is not separately mapped; the individual experts it contains (root.model.layers.{i}.mlp.experts.{j}) are mapped to the fused FusedMoE operator at root.model.layers.{i}.mlp.experts.",
            "root.model.layers.{i}.mlp.experts.{j}.gate_proj": "Individual expert gate projection for expert j in [0-63] in MoE layers i in [1-27]. In vLLM, all 64 experts are fused into a single FusedMoE operator at root.model.layers.{i}.mlp.experts. All expert parameters are loaded into the fused implementation. Mapped via parent expert container mapping root.model.layers.{i}.mlp.experts.{j} -> root.model.layers.{i}.mlp.experts.",
            "root.model.layers.{i}.mlp.experts.{j}.up_proj": "Individual expert up projection for expert j in [0-63] in MoE layers i in [1-27]. Fused into vLLM's FusedMoE at root.model.layers.{i}.mlp.experts. Mapped via parent expert container.",
            "root.model.layers.{i}.mlp.experts.{j}.down_proj": "Individual expert down projection for expert j in [0-63] in MoE layers i in [1-27]. Fused into vLLM's FusedMoE at root.model.layers.{i}.mlp.experts. Mapped via parent expert container.",
            "root.model.layers.{i}.mlp.experts.{j}.act_fn": "Individual expert activation function for expert j in [0-63] in MoE layers i in [1-27]. Fused into vLLM's FusedMoE at root.model.layers.{i}.mlp.experts. Mapped via parent expert container."
        },
        "vLLM": {
            "root.logits_processor": "vLLM-specific component for logits processing during generation. Not present in HF reference model architecture as it is an inference-time optimization component.",
            "root.model.layers.{k}.self_attn.rotary_emb": "RotaryEmbeddingWrapper within vLLM attention for layers k in [0-27]. Corresponds to the shared root.model.rotary_emb in HF (one-to-many mapping), but instantiated per-layer in vLLM for optimized execution. Implements the same rotary position embedding computation. Mapped to root.model.rotary_emb.",
            "root.model.layers.{k}.self_attn.attn": "vLLM-specific optimized Attention operator for layers k in [0-27]. This is a fused kernel that performs the attention computation (softmax, attention weights, output computation). It is part of the self_attn module execution path and does not have a direct component-level equivalent in HF which uses PyTorch operations. The parent self_attn module is already mapped, and this is an internal implementation detail of vLLM's attention optimization.",
            "root.model.layers.{i}.mlp.experts": "FusedMoE module in vLLM that fuses all 64 expert MLPs into a single optimized operator for layers i in [1-27]. All individual HF expert parameters (gate_proj, up_proj, down_proj, act_fn for each of the 64 experts j in [0-63]) are loaded into this fused implementation. Already mapped via parent expert container mapping root.model.layers.{i}.mlp.experts.{j} -> root.model.layers.{i}.mlp.experts.",
            "root.model.layers.{i}.mlp.experts.quant_method": "Quantization method container for FusedMoE in layers i in [1-27]. vLLM-specific implementation detail for quantization support, not present in HF reference model."
        }
    }
