    "reasoning": {
        "HF": {
            "root.model.rotary_emb": "Standalone rotary embedding module in HF. In vLLM, rotary embeddings are integrated within each attention layer as root.model.layers.{i}.self_attn.rotary_emb. Represents architectural difference in positional encoding management - HF uses shared module, vLLM uses per-layer wrappers.",
            "root.model.layers.{i}.mlp.experts.{j}.act_fn": "SiLU activation function in HF MoE experts. In vLLM's FusedMoE implementation, activation is handled internally by the MoE kernel backends (Cutlass/Triton) and fused into expert computation for performance. Not exposed as separate module."
        },
        "vLLM": {
            "root.model.layers.{i}.self_attn.attn": "RadixAttention module for KV-cached attention computation in vLLM. In HF, attention is computed inline in Qwen3MoeAttention.forward using eager_attention_forward or flash attention. Represents implementation difference - vLLM abstracts attention computation into specialized module.",
            "root.model.layers.{i}.self_attn.rotary_emb": "Per-layer RotaryEmbeddingWrapper in vLLM. HF uses single shared root.model.rotary_emb. Functionally equivalent but organizationally different - both apply same rotary positional encodings.",
            "root.model.layers.{i}.mlp.topk": "TopK module abstracts expert selection logic in vLLM (applies softmax, selects top-k, normalizes). In HF, this is implemented inline in Qwen3MoeSparseMoeBlock.forward using torch.topk and F.softmax. vLLM modularizes for backend optimization.",
            "root.logits_processor": "vLLM-specific component for logit processing and sampling. No HF equivalent as HF uses GenerationMixin interface. Not involved in forward pass accuracy - only affects sampling/generation behavior. Not relevant for activation comparison.",
            "root.model.layers.{i}.layer_communicator": "vLLM-specific component for managing tensor parallel communication (all-reduce, reduce-scatter) between layers and around attention/MLP blocks. No direct HF equivalent - HF handles distributed communication differently. Used for optimization in multi-GPU serving but not a computational component that affects single-GPU accuracy."
        }
    }
